      "nah",
      "ni",
      "hoyni",
      "hoini",
      "hoy nai",
      "koreni",
      "kore nai",
      "jayni"
    ],
    "negation_window_tokens": 3,
    "negation_logic": "Split raw text into clauses on clause_breaks before removing punctuation. Within a clause, if a negation token sits within 3 tokens (either side) of a matched cue for a label, and the negation token is outside the matched cue span, suppress that label. A negated fever_present becomes fever_dropped. cannot_drink and low_urine cues already contain a negation; that negation is inside the span and does not count. Exception: if a stop_word (stop, decrease) sits between the cue and the negation, the phrase means 'not stopping' or 'not decreasing' and the label is KEPT: 'bomi bondho hocche na', 'বমি থামছে না', 'pet betha kome na'.",
    "past_cues_bn": [
      "কাল",
      "কালকে",
      "গতকাল",
      "গত রাতে",
      "আগে",
      "পরশু",
      "গতকালকে"
    ],
    "past_cues_banglish": [
      "kal",
      "kalke",
      "gotokal",
      "gotokaal",
      "goto rate",
      "age",
      "porshu",
      "gotokalke"
    ],
    "past_logic": "If a past cue appears in the same clause as a matched cue, cap that label at the 'not sure' band. Past takes precedence over negation: 'kal bomi hoisilo aj nai' gives persistent_vomiting as not sure, never dropped. Ambiguity goes to a person. A token ending in any past_verb_ending (হয়েছিল, hoyechilo, hoisilo) also counts as a past cue.",
    "no_label_outcome": "If no warning sign and no status label clears 0.45, show 'বুঝতে পারিনি — ফোন করুন' (amber).",
    "fine_outcome": "If the only labels are feeling_better and/or fever_dropped, show 'কোনো সতর্কসংকেত পাওয়া যায়নি' (green).",
    "past_scope": "warning_signs only. Status labels (fever_dropped, feeling_better, etc.) are never capped by past cues.",
    "stop_words": [
      "থাম",
      "থামছে",
      "থামে",
      "বন্ধ",
      "কমছে",
      "কমে",
      "tham",
      "thame",
      "thamche",
      "thamtese",
