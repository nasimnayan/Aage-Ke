    ],
    "past_verb_endings": [
      "ছিল",
      "ছিলো",
      "chilo",
      "silo",
      "cilo",
      "chhilo"
    ],
    "aggregation": "A message can mention one label in several clauses. Suppress the label only if every clause that mentions it is negated. If the remaining mentions are all past, the label is 'not sure'. Otherwise use the model band."
  },
